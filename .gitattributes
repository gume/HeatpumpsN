# Normalize text files to LF in the repository.
* text=auto eol=lf

# Explicit text types
*.c      text
*.cpp    text
*.h      text
*.hpp    text
*.ini    text
*.md     text
*.py     text
*.json   text
*.yml    text
*.yaml   text

# Binary assets
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.pdf    binary
*.gz     binary
*.zip    binary
*.duckdb binary
*.bin    binary
*.elf    binary
