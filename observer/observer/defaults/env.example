# Copy to .env (git-ignored). Read at start; real environment variables win.

# InfluxDB (development: the token from docker-compose.dev.yml)
INFLUX_TOKEN=observer-dev-token
# Read-only token for the agent tools (influx auth create --read-bucket <bucket id>)
OBSERVER_INFLUX_READ_TOKEN=

# LLM providers: endpoint and key per slot (any OpenAI-compatible API).
# Names and the model per task are chosen on the portal's Settings page.
# Ollama: http://<host>:11434/v1, no key needed.
OBSERVER_LLM_BASE_URL=
OBSERVER_LLM_KEY=
# OBSERVER_LLM_2_BASE_URL=
# OBSERVER_LLM_2_KEY=
