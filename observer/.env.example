# Copy to .env (git-ignored). Read at start; real environment variables win.

# InfluxDB (development: the token from docker-compose.dev.yml)
INFLUX_TOKEN=observer-dev-token

# LLM for signal descriptions: any OpenAI-compatible endpoint.
# Ollama: http://<host>:11434/v1, no key needed.
OBSERVER_LLM_BASE_URL=
OBSERVER_LLM_MODEL=
OBSERVER_LLM_KEY=
