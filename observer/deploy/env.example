# Copy to .env next to docker-compose.yml (git-ignored) and fill in.
# Generate secrets with: openssl rand -hex 32

# --- InfluxDB (used only on the very first start to set the database up) ---
INFLUX_ADMIN_USER=observer
INFLUX_ADMIN_PASSWORD=
INFLUX_ADMIN_TOKEN=
INFLUX_ORG=heatpumpsn
INFLUX_BUCKET=observer
# Publish the InfluxDB UI: 127.0.0.1 (this machine only) or 0.0.0.0
INFLUX_BIND=127.0.0.1
INFLUX_PORT=8086

# --- MQTT: the home broker ---
OBSERVER_MQTT_HOST=mqtt.home
OBSERVER_MQTT_PORT=1883
OBSERVER_MQTT_USER=
OBSERVER_MQTT_PASSWORD=
# Empty at home (subscribe to everything); "mirror/" behind a bridge like the development one
OBSERVER_MQTT_TOPIC_PREFIX=

# --- Portal ---
# 127.0.0.1 (this machine only, e.g. through an SSH tunnel) or 0.0.0.0 (the network: set a password)
OBSERVER_BIND=127.0.0.1
OBSERVER_PORT=8090
OBSERVER_PORTAL_USER=admin
OBSERVER_PORTAL_PASSWORD=

# --- LLM (optional; models per task on the portal's Settings page) ---
# A proxy on this machine: http://host.docker.internal:<port>/v1
OBSERVER_LLM_BASE_URL=
OBSERVER_LLM_KEY=
# More providers: OBSERVER_LLM_2_BASE_URL / OBSERVER_LLM_2_KEY ... up to 9
# OBSERVER_LLM_2_BASE_URL=
# OBSERVER_LLM_2_KEY=

# --- Agent sandbox (optional, see README): allow bubblewrap in the observer container ---
# COMPOSE_FILE=docker-compose.yml:docker-compose.sandbox.yml   (both are links in the install folder)
# OBSERVER_MEM_LIMIT=3g

# --- Update checks of private repositories (optional) ---
# OBSERVER_GITHUB_TOKEN=

# The user the containers run as (they write data/): your own `id -u` / `id -g`
# makes the files in data/ yours. Default 1000.
# OBSERVER_UID=1000
# OBSERVER_GID=1000

# Time zone of the containers, e.g. Europe/Budapest
TZ=UTC
